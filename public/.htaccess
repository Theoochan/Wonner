<IfModule mod_rewrite.c>
    RewriteEngine On

    # Se o caminho corresponde a um arquivo ou pasta que existe de verdade
    # (css, js, imagem), o Apache serve direto, sem passar pelo PHP.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Qualquer outra coisa vai para o front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Nunca listar o conteúdo de uma pasta sem index.
Options -Indexes
